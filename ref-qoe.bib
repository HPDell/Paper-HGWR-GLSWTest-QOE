  year = 2014,
  journal = {Sociological Studies},
  volume = {29},
  number = {2},
  pages = {65-89+243},
  issn = {1002-5936},
  abstract = {Based on national survey data of 2006,2008 and 2011,this paper uses the educational transition model developed by Mare to examine the trend in opportunity inequality between urban and rural children at all educational levels during 1940-2010.Comparison of different birth cohorts shows that the inequality at primary education is reducing but the inequality of accessing to junior middle education remains stable.At the same time,the inequality of accessing senior middle education has been increasing significantly and the inequality of accessing higher education has a modest rise.The author argues that the key point of educational stratification in China is at the selection of senior middle education.The rising gap between people from urban and rural families in higher education is because many rural children drop out of school at the middle education stage.In addition,the paper tests the industrialization thesis,the reproduction theory and the credentialism hypothesis.The results of data analysis strongly support the reproduction theory.},
  langid = {english},
