@article{Xie-2011,
  title = {Analysis on Inter-provincial Disparities of {{China}}'s Rural Education and Convergence Rate},
  author = {Xie, Tongwei},
  year = 2011,
  month = jan,
  journal = {International Journal of Educational Management},
  volume = {25},
  number = {7},
  pages = {714--723},
  publisher = {Emerald Group Publishing Limited},
  issn = {0951-354X},
  doi = {10.1108/09513541111172117},
  abstract = {Purpose -- This article aims to analyze inter-provincial disparities of rural education and the convergence rate, and to discuss the effects of compulsory education reform after 2001.本文旨在分析农村教育的省际差异及其收敛速度，并讨论 2001 年后义务教育改革的影响。 Design/methodology/approach -- The article estimates the rural average education years and education Gini coefficients of China's 31 provinces (municipalities) beside Hong Kong, Macao and Taiwan from 2001 to 2008, and applies the method of ``economic convergence''.该文章估算了 2001 年至 2008 年中国除香港、澳门和台湾外的 31 个省（直辖市）的农村平均受教育年限和教育基尼系数，并应用了``经济收敛''方法。 Findings -- The results show that after the reform of rural compulsory education, inter-provincial rural education disparities and educational equality have been significantly improved and trend to convergence; nevertheless the convergence rate on inter-provincial disparities of education equality declines. The defects of the education input system -- ``county as principle'' -- has been a factor that restricts the coordinated development of rural education.结果显示，农村义务教育改革后，省际农村教育差距和教育公平性显著改善并趋于收敛；然而，省际教育公平性差距的收敛速度有所下降。教育投入体制``以县为主''的缺陷成为制约农村教育协调发展的因素。 Practical limitations -- This paper suggests that it is necessary for China's provincial and central government to afford the expense of compulsory education. China's present investment system would also worsen inter-provincial inequities of education.本文建议，中国的省级和中央政府有必要承担义务教育的费用。中国目前的投资体系也会加剧省际教育不平等。 Social implications -- Education equality is one of the basic social priorities. In China education equality has been improved; however it could be better if China's provincial and central government afforded the expenses of compulsory education.教育平等是基本的社会优先事项之一。在中国，教育平等已经有所改善；然而，如果中国的省级和中央政府能够承担义务教育的费用，情况可能会更好。 Originality/value -- This paper applies the method of ``economic convergence'' to analyze China's rural education disparities among its regions.本文运用``经济趋同''方法分析中国各地区农村教育差异。},
  langid = {english},
  keywords = {Average educational years,China,Convergence,Education,Educational Gini coefficients,Educational policy,Rural areas}
}

