  title = {Corporate Social Responsibility in the Development of {{China}}'s Rural Education: A Case Study of Two Counties in Anhui Province},
  shorttitle = {Corporate Social Responsibility in the Development of {{China}}'s Rural Education},
  author = {Jingbo, Hua and Natalie, Wong Wai-man},
  year = 2020,
